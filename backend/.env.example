# Database Configuration (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/medisaarthi

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="Medisaarthi Backend"

# CORS Configuration (Allowed frontend origins)
CORS_ORIGINS=["http://localhost:3000"]

# AI / STT / TTS Integration Providers (Defaults to mock)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STT_PROVIDER=mock
STT_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=

